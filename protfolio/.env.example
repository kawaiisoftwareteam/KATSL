RESEND_API_KEY=your_resend_api_key
# If your Resend setup is still in testing mode, you may need to use your own email
# address for CONTACT_TO_EMAIL until you verify a domain for CONTACT_FROM_EMAIL:
# https://resend.com/domains
#
# For Resend testing mode, `onboarding@resend.dev` is commonly allowed as `from`,
# but `to` may need to be your own account email.
CONTACT_FROM_EMAIL=KATSL Contact <onboarding@resend.dev>
CONTACT_TO_EMAIL=your-email@gmail.com
